    {
      "parameters": {
        "jsCode": "const orderDetails = {\n  orderNumber: Number($json.body.order_number), // e.g. 1002\n\n  orderDate: $json.body.created_at.split(\"T\")[0], // e.g. 2026-06-17\n  orderTime: $json.body.created_at.split(\"T\")[1].split(\"-\")[0], // e.g. 10:19:57\n\n  contactInformation: {\n    email: $json.body.contact_email,\n    phone: $json.body.phone || $json.body.shipping_address?.phone || \"Not provided\",\n  },\n\n  shoppersName: $json.body.shipping_address?.name,\n\n  shippingAddress: {\n    street: $json.body.shipping_address?.address1,\n    city: $json.body.shipping_address?.city,\n    state: $json.body.shipping_address?.province,\n    zipCode: $json.body.shipping_address?.zip,\n    country: $json.body.shipping_address?.country,\n  },\n\n  itemOrdered: $json.body.line_items?.map(item => ({\n    productName: item.name,\n    quantity: Number(item.quantity),\n    unitPrice: Number(item.price),\n  })),\n\n  shippingMethod: $json.body.shipping_lines?.[0]?.title,\n\n  paymentMethod: $json.body.payment_gateway_names?.[0],\n\n  totalAmountPaid: Number($json.body.current_total_price),\n};\n\nreturn [{ json: orderDetails }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
