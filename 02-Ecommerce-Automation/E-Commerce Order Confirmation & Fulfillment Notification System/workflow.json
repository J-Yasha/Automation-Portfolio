    {
      "parameters": {
        "sendTo": "={{ $json.contactInformation.email }}",
        "subject": "Your Order Has Been Received, Here Is What Happens Next",
        "emailType": "text",
        "message": "=Hi {{ $json.shoppersName }},\n\nThank you for your order. We have received it and our team is already on it.\n\nHere is a summary of your order:\nOrder Number: {{ $json.orderNumber }}\n\nItems Ordered: {{ $json.itemOrdered[0].productName }}\n\nDelivery Address: {{ $json.shippingAddress.country }}, {{ $json.shippingAddress.state }}, {{ $json.shippingAddress.city }}, {{ $json.shippingAddress.street }}, {{ $json.shippingAddress.zipCode }}\n\nOrder Total: ₦{{ $json.totalAmountPaid }}\n\nWhat happens next:\n1. Our fulfillment team has been notified and will begin processing your order immediately.\n2. You will receive a shipping update once your order is on its way.\n3. If you have any questions in the meantime, simply reply to this email.\n\nWe appreciate your trust in us and look forward to delivering an excellent experience.\n\nBest regards,\nJoshua T. Ikotun",
        "options": {
          "appendAttribution": false
        }
      },
