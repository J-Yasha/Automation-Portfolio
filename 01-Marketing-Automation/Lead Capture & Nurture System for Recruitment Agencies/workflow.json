        "sendTo": "={{ $('Edit Fields').item.json['Email Address'] }}",
        "subject": "We Have Received Your Application, Here Is What Happens Next",
        "emailType": "text",
        "message": "=Hi {{ $('Edit Fields').item.json['Full Name'] }},\n\nThank you for your interest in opportunities through our agency. We have received your application for {{ $('Edit Fields').item.json['Role Interest'] }}, and we are pleased to let you know that your profile has caught our attention.\n\nHere is what happens next:\nOne of our recruitment consultants will review your profile in detail and reach out to you within the next 48 hours to discuss potential opportunities that match your experience and availability.\n\nIn the meantime, if you have any questions or would like to share additional information about your background, simply reply to this email.\n\nWe look forward to speaking with you soon.\n\nBest regards,\nJoshua T. Ikotun\nRecruitment Consultant",
        "options": {
          "appendAttribution": false
        }
      },
