    {
      "parameters": {
        "jsCode": "// This code:\n// 1. Takes each candidate's \"Applied Date\" (dd/mm/yyyy).\n// 2. Adds 3 days to the Applied Date.\n// 3. Checks if today's date is on or after the resulting date.\n// 4. Checks if \"Check-In\" is \"Not Yet\".\n// 5. If BOTH conditions are true, sets \"Check-In Reminder\" to \"SEND\".\n// 6. Otherwise, sets it to \"DON'T SEND\".\n// 7. Returns all original data along with the reminder status.\n\nconst today = new Date();\n\nconst formatDate = (date) => {\n  const day = String(date.getDate()).padStart(2, \"0\");\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const year = date.getFullYear();\n  return `${day}/${month}/${year}`;\n};\n\nreturn $input.all().map(item => {\n  const appliedDateString = item.json[\"Applied Date\"];\n\n  const [day, month, year] = appliedDateString.split(\"/\").map(Number);\n\n  const reminderDate = new Date(year, month - 1, day);\n\n  // Add 3 days to the Applied Date\n  reminderDate.setDate(reminderDate.getDate() + 3);\n\n  const shouldSend =\n    today >= reminderDate &&\n    item.json[\"Check-In\"].toLowerCase() === \"not yet\";\n\n  return {\n    json: {\n      ...item.json,\n      \"Check-In Reminder Date\": formatDate(reminderDate),\n      \"Check-In Reminder\": shouldSend ? \"SEND\" : \"DON'T SEND\",\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        -48
      ],
      "id": "e78a36bb-a3f2-41db-8e22-6d8cd60d7ae6",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Get row(s) in sheet').item.json.Email }}",
        "subject": "=Just Checking In, {{ $('Get row(s) in sheet').item.json.Name }}",
        "emailType": "text",
        "message": "=Hi {{ $('Get row(s) in sheet').item.json.Name }},\n\nI hope you are doing well.\n\nWe wanted to follow up on your recent application for {{ $('Get row(s) in sheet').item.json['Role Interest'] }} submitted on {{ $json['Applied Date'] }}. We have not forgotten about you, and your profile is still very much under active consideration.\n\nOur team is currently matching profiles to available opportunities, and we expect to be in touch with you very shortly with an update.\n\nIf anything has changed regarding your availability or role preferences since you applied, please reply to this email to let us know so we can ensure we find you the best possible match.\n\nI appreciate your patience, and we look forward to connecting with you soon.\n\nBest regards,\nJoshua T. Ikotun,\nRecruitment Consultant.",
        "options": {}
      },
