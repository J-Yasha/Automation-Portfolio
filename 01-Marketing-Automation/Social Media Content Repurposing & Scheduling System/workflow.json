    {
      "parameters": {
        "jsCode": "const output = $json.output;\n\nconst date = output.match(\n  /Created Time:\\s*([\\s\\S]*?)\\n\\nLinkedIn Post:/\n)?.[1]?.trim().split(\"T\")[0];\n\nconst linkedinPost = output.match(\n  /LinkedIn Post:\\s*([\\s\\S]*?)\\n\\nX Post:/\n)?.[1]?.trim();\n\nconst xPost = output.match(\n  /X Post:\\s*([\\s\\S]*?)\\n\\nNewsletter Teaser:/\n)?.[1]?.trim();\n\nconst newsletterTeaser = output.match(\n  /Newsletter Teaser:\\s*([\\s\\S]*)/\n)?.[1]?.trim();\n\nreturn [\n  {\n    json: {\n      date,\n\n      media: {\n        linkedin: \"LinkedIn\",\n        x: \"X\",\n        newsletter: \"Newsletter\",\n      },\n\n      content: {\n        linkedin_post: linkedinPost,\n        x_post: xPost,\n        newsletter_teaser: newsletterTeaser,\n      },\n    },\n  },\n];"
      },
