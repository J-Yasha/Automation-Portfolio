    {
      "parameters": {
        "jsCode": "// This code:\n// 1. Takes the invoice's Due Date (dd/mm/yyyy).\n// 2. Adds 7 days to it.\n// 3. Compares the resulting date with today's date.\n// 4. If today's date matches the Due Date + 7 days, sets the reminder to \"SEND\".\n// 5. Otherwise, sets the reminder to \"DON'T SEND\".\n// 6. Returns all invoice data along with the new reminder status.\n\nconst today = new Date();\n\nconst formatDate = (date) => {\n  const day = String(date.getDate()).padStart(2, \"0\");\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const year = date.getFullYear();\n  return `${day}/${month}/${year}`;\n};\n\nconst todayFormatted = formatDate(today);\n\nreturn $input.all().map(item => {\n  const dueDateString = item.json[\"Due Date\"];\n\n  const [day, month, year] = dueDateString.split(\"/\").map(Number);\n\n  const dueDate = new Date(year, month - 1, day);\n\n  // Add 7 days to the Due Date\n  dueDate.setDate(dueDate.getDate() + 7);\n\n  const reminderDate = formatDate(dueDate);\n\n  return {\n    json: {\n      ...item.json,\n      \"Second Reminder Date\": reminderDate,\n      \"Second Reminder Status\":\n        reminderDate === todayFormatted ? \"SEND\" : \"DON'T SEND\",\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -384
      ],
      "id": "5a5fe53a-b410-43bd-ac4d-c610d23fea2a",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// This code:\n// 1. Gets today's date.\n// 2. Formats today's date as dd/mm/yyyy.\n// 3. Compares today's date with each invoice's Due Date.\n// 4. If both dates are exactly the same, sets \"Due Date Reminder\" to \"DUE\".\n// 5. Otherwise, sets it to \"NOT DUE\".\n// 6. Returns all invoices with the updated reminder status.\n\nconst today = new Date();\n\nconst formatDate = (date) => {\n  const day = String(date.getDate()).padStart(2, \"0\");\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const year = date.getFullYear();\n  return `${day}/${month}/${year}`;\n};\n\nconst todayFormatted = formatDate(today);\n\nreturn $input.all().map(item => {\n  const dueDate = item.json[\"Due Date\"];\n\n  return {\n    json: {\n      ...item.json,\n      \"Due Date Reminder\":\n        dueDate === todayFormatted ? \"DUE\" : \"NOT DUE\",\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
